# Local configuration. Create .env with `npm run setup` (recommended) or copy
# this file to .env and fill it in by hand. .env is gitignored - never commit it.
#
# The same values are pushed to the FastEdge app by `npm run deploy`.

# Supabase: Project Settings -> API Keys (URL looks like https://<ref>.supabase.co)
FASTEDGE_VAR_ENV_SUPABASE_URL=
FASTEDGE_VAR_ENV_SUPABASE_PUBLISHABLE_KEY=

# Random 64-hex-char secret; `npm run setup` generates it.
FASTEDGE_VAR_SECRET_FORM_SECRET=

# Admin password for /admin, tests and export. `npm run setup` generates it
# and prints the SQL that registers its hash in Supabase. Not sent to FastEdge.
ADMIN_TOKEN=
